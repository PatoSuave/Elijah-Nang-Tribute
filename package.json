{
  "name": "elijah-nang-tribute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "node scripts/build-worker.mjs local",
    "build:staging": "node scripts/build-worker.mjs staging",
    "build:production": "node scripts/build-worker.mjs production",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "test:memorial:integration": "node --experimental-strip-types scripts/test-memorial-integration.mjs",
    "test:worker": "node scripts/test-worker-http.mjs",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types worker-configuration.d.ts --include-runtime false",
    "db:migrate": "wrangler d1 migrations apply MEMORIAL_DB --local",
    "db:migrate:legacy:postgres": "node scripts/run-migrations.mjs",
    "deploy:staging": "node scripts/deploy-worker.mjs staging",
    "deploy:production": "node scripts/deploy-worker.mjs production"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.2.0",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.6.0",
    "react-server-dom-webpack": "19.3.1",
    "server-only": "^0.0.1",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "miniflare": "5.20261019.2-beta",
    "pg": "8.23.0",
    "railway": "3.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "fflate": "0.7.5"
  },
  "type": "module"
}
